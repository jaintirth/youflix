# MongoDB (Atlas connection string, or mongodb://localhost:27017)
MONGODB_URI=
MONGODB_DB=youflix

# Admin login password for /admin. Set this before deploying: the default is "admin".
ADMIN_PASSWORD=change-me

# Free key from https://www.themoviedb.org/settings/api (v3 key, or use TMDB_TOKEN for the v4 token)
TMDB_API_KEY=
